{
  "name": "cosmos-cli",
  "version": "0.0.1",
  "description": "Search cosmos.so and download image and video assets with your logged-in Chrome session via playwriter.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cosmos": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "typecheck": "tsc",
    "test": "vitest --dir src"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/cosmos-cli"
  },
  "keywords": [
    "cosmos",
    "cosmos.so",
    "cli",
    "playwriter",
    "images",
    "assets",
    "agent"
  ],
  "author": "remorses",
  "license": "MIT",
  "dependencies": {
    "errore": "^0.14.1",
    "goke": "^6.18.0",
    "playwriter": "^0.9.0",
    "string-dedent": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
